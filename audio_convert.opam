opam-version: "2.0"
synopsis: "A CLI tool to convert audio files to MP3 and OGG"
description:
  "A minimal OCaml command-line utility that converts common audio formats (WAV, AIFF, FLAC) to MP3 and OGG using system ffmpeg, with optional silence trimming. Dependency-light, using only stdlib and unix."
maintainer: ["Ryan Sadwick <rsadwick@gmail.com>"]
authors: ["Ryan Sadwick <rsadwick@gmail.com>"]
license: "MIT"
tags: ["ocaml" "audio" "converter" "cli" "ffmpeg" "," "gamedev"]
homepage: "https://github.com/3ee-Games/ocaml-audio-convert"
doc: "https://github.com/3ee-Games/ocaml-audio-convert/#readme"
bug-reports: "https://github.com/3ee-Games/ocaml-audio-convert/issues"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.20" & >= "3.20"}
  "unix"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/3ee-Games/ocaml-audio-convert.git"
